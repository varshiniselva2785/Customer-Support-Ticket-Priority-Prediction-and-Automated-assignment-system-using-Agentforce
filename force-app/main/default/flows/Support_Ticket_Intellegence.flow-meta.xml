<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <processType>AutoLaunchedFlow</processType>
    <label>Support Ticket Intelligence</label>
    <description>Retrieves the latest ticket for an Account, classifies priority from configured keywords, creates an urgent Task for High priority, and returns output for Agentforce.</description>

    <variables>
        <name>varAccountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varTicketId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varPriorityLevel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varAssignedTo</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varActionMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <start>
        <locationX>50</locationX><locationY>50</locationY>
        <connector><targetReference>Get_Account</targetReference></connector>
    </start>

    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>50</locationX><locationY>150</locationY>
        <object>Account</object>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <field>Name</field><operator>EqualTo</operator><value><elementReference>varAccountName</elementReference></value>
        </conditions>
        <sortField>CreatedDate</sortField><sortOrder>Descending</sortOrder>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <connector><targetReference>Store_Account_Id</targetReference></connector>
    </recordLookups>

    <assignments>
        <name>Store_Account_Id</name><label>Store Account Id</label>
        <locationX>50</locationX><locationY>250</locationY>
        <assignmentItems><assignToReference>varAccountId</assignToReference><operator>Assign</operator><value><elementReference>Get_Account.Id</elementReference></value></assignmentItems>
        <connector><targetReference>Get_Ticket</targetReference></connector>
    </assignments>

    <recordLookups>
        <name>Get_Ticket</name><label>Get Ticket</label>
        <locationX>50</locationX><locationY>350</locationY>
        <object>Support_Ticket_Intelligence__c</object>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <field>Customer__c</field><operator>EqualTo</operator><value><elementReference>varAccountId</elementReference></value>
        </conditions>
        <sortField>CreatedDate</sortField><sortOrder>Descending</sortOrder>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <connector><targetReference>Store_Ticket_Id</targetReference></connector>
    </recordLookups>

    <assignments>
        <name>Store_Ticket_Id</name><label>Store Ticket Id</label>
        <locationX>50</locationX><locationY>450</locationY>
        <assignmentItems><assignToReference>varTicketId</assignToReference><operator>Assign</operator><value><elementReference>Get_Ticket.Id</elementReference></value></assignmentItems>
        <connector><targetReference>Analyze_Description</targetReference></connector>
    </assignments>

    <decisions>
        <name>Analyze_Description</name><label>Analyze Description</label>
        <locationX>50</locationX><locationY>550</locationY>
        <rules>
            <name>High_Priority</name><label>High Priority</label><conditionLogic>or</conditionLogic>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>urgent</stringValue></rightValue></conditions>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>not working</stringValue></rightValue></conditions>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>failure</stringValue></rightValue></conditions>
            <connector><targetReference>Set_High_Priority</targetReference></connector>
        </rules>
        <rules>
            <name>Medium_Priority</name><label>Medium Priority</label><conditionLogic>or</conditionLogic>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>issue</stringValue></rightValue></conditions>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>slow</stringValue></rightValue></conditions>
            <conditions><leftValueReference>Get_Ticket.Description__c</leftValueReference><operator>Contains</operator><rightValue><stringValue>delay</stringValue></rightValue></conditions>
            <connector><targetReference>Set_Medium_Priority</targetReference></connector>
        </rules>
        <defaultConnector><targetReference>Set_Low_Priority</targetReference></defaultConnector>
        <defaultConnectorLabel>Low Priority</defaultConnectorLabel>
    </decisions>

    <assignments>
        <name>Set_High_Priority</name><label>Set High Priority</label><locationX>20</locationX><locationY>650</locationY>
        <assignmentItems><assignToReference>varPriorityLevel</assignToReference><operator>Assign</operator><value><stringValue>High</stringValue></value></assignmentItems>
        <connector><targetReference>High_Priority_Check</targetReference></connector>
    </assignments>
    <assignments>
        <name>Set_Medium_Priority</name><label>Set Medium Priority</label><locationX>180</locationX><locationY>650</locationY>
        <assignmentItems><assignToReference>varPriorityLevel</assignToReference><operator>Assign</operator><value><stringValue>Medium</stringValue></value></assignmentItems>
        <connector><targetReference>Set_Final_Message_Medium</targetReference></connector>
    </assignments>
    <assignments>
        <name>Set_Low_Priority</name><label>Set Low Priority</label><locationX>340</locationX><locationY>650</locationY>
        <assignmentItems><assignToReference>varPriorityLevel</assignToReference><operator>Assign</operator><value><stringValue>Low</stringValue></value></assignmentItems>
        <connector><targetReference>Set_Final_Message_Low</targetReference></connector>
    </assignments>

    <decisions>
        <name>High_Priority_Check</name><label>Is High Priority</label><locationX>20</locationX><locationY>750</locationY>
        <rules>
            <name>High</name><label>High</label>
            <conditions><leftValueReference>varPriorityLevel</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>High</stringValue></rightValue></conditions>
            <connector><targetReference>Create_Urgent_Task</targetReference></connector>
        </rules>
        <defaultConnector><targetReference>Set_Final_Message_Low</targetReference></defaultConnector>
    </decisions>

    <recordCreates>
        <name>Create_Urgent_Task</name><label>Create Urgent Task</label><locationX>20</locationX><locationY>850</locationY>
        <object>Task</object>
        <inputAssignments><field>Subject</field><value><stringValue>Urgent Ticket Handling</stringValue></value></inputAssignments>
        <inputAssignments><field>WhatId</field><value><elementReference>varTicketId</elementReference></value></inputAssignments>
        <inputAssignments><field>Priority</field><value><stringValue>High</stringValue></value></inputAssignments>
        <inputAssignments><field>Status</field><value><stringValue>Not Started</stringValue></value></inputAssignments>
        <connector><targetReference>Set_Assigned_Agent</targetReference></connector>
    </recordCreates>

    <assignments>
        <name>Set_Assigned_Agent</name><label>Set Assigned Agent</label><locationX>20</locationX><locationY>950</locationY>
        <assignmentItems><assignToReference>varAssignedTo</assignToReference><operator>Assign</operator><value><stringValue>Senior Support Agent</stringValue></value></assignmentItems>
        <connector><targetReference>Set_Final_Message_High</targetReference></connector>
    </assignments>

    <assignments>
        <name>Set_Final_Message_High</name><label>Set Final Message High</label><locationX>20</locationX><locationY>1050</locationY>
        <assignmentItems><assignToReference>varActionMessage</assignToReference><operator>Assign</operator><value><stringValue>High priority ticket detected. Assigned to senior agent.</stringValue></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Final_Message_Medium</name><label>Set Final Message Medium</label><locationX>180</locationX><locationY>750</locationY>
        <assignmentItems><assignToReference>varAssignedTo</assignToReference><operator>Assign</operator><value><stringValue>Support Team</stringValue></value></assignmentItems>
        <connector><targetReference>Set_Medium_Message</targetReference></connector>
    </assignments>
    <assignments>
        <name>Set_Medium_Message</name><label>Set Medium Message</label><locationX>180</locationX><locationY>850</locationY>
        <assignmentItems><assignToReference>varActionMessage</assignToReference><operator>Assign</operator><value><stringValue>Ticket marked as medium priority. Will be handled shortly.</stringValue></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Final_Message_Low</name><label>Set Low Message</label><locationX>340</locationX><locationY>750</locationY>
        <assignmentItems><assignToReference>varAssignedTo</assignToReference><operator>Assign</operator><value><stringValue>Support Queue</stringValue></value></assignmentItems>
        <connector><targetReference>Set_Low_Message</targetReference></connector>
    </assignments>
    <assignments>
        <name>Set_Low_Message</name><label>Set Low Message</label><locationX>340</locationX><locationY>850</locationY>
        <assignmentItems><assignToReference>varActionMessage</assignToReference><operator>Assign</operator><value><stringValue>Ticket is low priority and queued for processing.</stringValue></value></assignmentItems>
    </assignments>
</Flow>
